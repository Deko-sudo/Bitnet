<Window x:Class="BitNet.TestWindow.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="WPF Test Window" Width="400" Height="300">
  <Grid Background="LightBlue">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="Hello from WPF!" FontSize="24" Foreground="DarkBlue"/>
      <Button Content="Click Me" Margin="0,20,0,0" Padding="20,10"
               Click="Button_Click"/>
      <TextBlock x:Name="StatusText" Text="" Margin="0,10,0,0" Foreground="Green"/>
    </StackPanel>
  </Grid>
</Window>
