<Page
    x:Class="BitNet.Desktop.Views.EntryEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid MaxWidth="640" HorizontalAlignment="Center" Margin="24">
        <StackPanel Spacing="16">
            <TextBlock x:Name="PageTitle"
                       Text="Add Entry"
                       Style="{StaticResource TitleLargeTextBlockStyle}">
                <TextBlock.Transitions>
                    <TransitionCollection/>
                </TextBlock.Transitions>
            </TextBlock>
            
            <TextBox x:Name="TitleBox"
                     Header="Title"
                     PlaceholderText="e.g. GitHub">
                <TextBox.Transitions>
                    <TransitionCollection/>
                </TextBox.Transitions>
            </TextBox>
            
            <TextBox x:Name="UsernameBox"
                     Header="Username"
                     PlaceholderText="e.g. alice@example.com">
                <TextBox.Transitions>
                    <TransitionCollection/>
                </TextBox.Transitions>
            </TextBox>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <PasswordBox x:Name="PasswordBox"
                              Grid.Column="0"
                              Header="Password"
                              PlaceholderText="Enter password..."/>
                
                <Button Grid.Column="1"
                        Content="Generate"
                        Click="GeneratePassword_Click"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,0"></Button>
            </Grid>
            
            <TextBox x:Name="UrlBox"
                     Header="URL"
                     PlaceholderText="https://github.com">
                <TextBox.Transitions>
                    <TransitionCollection/>
                </TextBox.Transitions>
            </TextBox>
            
            <TextBox x:Name="TOTPUriBox"
                     Header="TOTP Secret or otpauth:// URI"
                     PlaceholderText="JBSWY3DPEHPK3PXP or otpauth://totp/...">
                <TextBox.Transitions>
                    <TransitionCollection/>
                </TextBox.Transitions>
            </TextBox>
            
            <TextBox x:Name="NotesBox"
                     Header="Notes"
                     PlaceholderText="Additional notes..."
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="80">
                <TextBox.Transitions>
                    <TransitionCollection/>
                </TextBox.Transitions>
            </TextBox>
            
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Content="Save"
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"></Button>
                
                <Button Grid.Column="1"
                        Content="Cancel"
                        Click="CancelButton_Click"></Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>