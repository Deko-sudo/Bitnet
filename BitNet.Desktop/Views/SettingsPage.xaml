<Page
    x:Class="BitNet.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid MaxWidth="640" HorizontalAlignment="Center" Margin="24">
        <StackPanel Spacing="24">
            <TextBlock Text="Settings"
                       Style="{StaticResource TitleLargeTextBlockStyle}">
                <TextBlock.Transitions>
                    <TransitionCollection/>
                </TextBlock.Transitions>
            </TextBlock>
            
            <!-- Security Section -->
            <Grid Padding="20"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock Text="Security"
                               Style="{StaticResource SubtitleTextBlockStyle}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>

                    <ToggleSwitch x:Name="AutoLockToggle"
                                  Header="Auto-lock after inactivity"
                                  IsOn="True"
                                  Toggled="AutoLockToggle_Toggled">
                        <ToggleSwitch.Transitions>
                            <TransitionCollection/>
                        </ToggleSwitch.Transitions>
                    </ToggleSwitch>

                    <TextBlock Text="Auto-lock timeout"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,8,0,0">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>

                    <TextBlock Text="The vault will lock after this period of inactivity. We recommend 15 minutes — long enough for a normal session, short enough that a forgotten laptop isn't a breach."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,-8,0,0">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>

                    <!-- Bitwarden-style discrete timeout options. -->
                    <!-- A ComboBox gives clearer affordance than -->
                    <!-- the previous continuous Slider; users can -->
                    <!-- pick a known-safe value instead of guessing. -->
                    <ComboBox x:Name="AutoLockTimeoutCombo"
                              Header="Lock after"
                              SelectionChanged="AutoLockTimeoutCombo_SelectionChanged"
                              HorizontalAlignment="Stretch"
                              MaxWidth="320">
                        <ComboBoxItem Content="Never" Tag="0"/>
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                        <ComboBoxItem Content="15 minutes (recommended)" Tag="900"/>
                        <ComboBoxItem Content="1 hour" Tag="3600"/>
                        <ComboBoxItem Content="4 hours" Tag="14400"/>
                    </ComboBox>

                    <TextBlock x:Name="AutoLockHint"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Default: 15 minutes. The setting persists across app restarts."/>

                    <Button x:Name="LockNowButton"
                            Content="Lock Vault Now"
                            Click="LockNow_Click"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Style="{StaticResource AccentButtonStyle}"></Button>
                </StackPanel>
            </Grid>
            
            <!-- Appearance Section -->
            <Grid Padding="20"
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance"
                               Style="{StaticResource SubtitleTextBlockStyle}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                    
                    <TextBlock Text="Theme"
                               Style="{StaticResource BodyStrongTextBlockStyle}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                    
                    <RadioButtons x:Name="ThemeRadioButtons"
                                  SelectedIndex="0">
                        <RadioButton Content="System default"/>
                        <RadioButton Content="Light"/>
                        <RadioButton Content="Dark"/>
                    </RadioButtons>
                </StackPanel>
            </Grid>
            
            <!-- About Section -->
            <Grid Padding="20"
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="About BitNet"
                               Style="{StaticResource SubtitleTextBlockStyle}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                    
                    <TextBlock Text="Version 0.1.0"
                               Style="{StaticResource BodyTextBlockStyle}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                    
                    <TextBlock Text="Zero Trust Password Manager"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                    
                    <TextBlock Text="Offline. Encrypted. Yours."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBlock.Transitions>
                            <TransitionCollection/>
                        </TextBlock.Transitions>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>