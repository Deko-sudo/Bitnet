<Page
    x:Class="BitNet.Desktop.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
        <StackPanel Spacing="16" Padding="32">
            <FontIcon Glyph="&#xE9A1;" FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
            
            <TextBlock Text="Password Generator"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       HorizontalAlignment="Center">
                <TextBlock.Transitions>
                    <TransitionCollection/>
                </TextBlock.Transitions>
            </TextBlock>
            
            <!-- Result display -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="ResultBox"
                          IsReadOnly="True"
                          PlaceholderText="Generated password..."
                          FontFamily="Consolas">
                    <TextBox.Transitions>
                        <TransitionCollection/>
                    </TextBox.Transitions>
                </TextBox>
                
                <Button Grid.Column="1"
                        Click="CopyButton_Click"
                        Margin="8,0,0,0">
                    <Button.Icon>
                        <FontIcon Glyph="&#xE8C8;"/>
                    </Button.Icon>
                </Button>
            </Grid>
            
            <!-- Strength indicator -->
            <ProgressBar x:Name="StrengthBar"
                         Minimum="0"
                         Maximum="100"
                         Value="0">
                <ProgressBar.Transitions>
                    <TransitionCollection/>
                </ProgressBar.Transitions>
            </ProgressBar>
            
            <TextBlock x:Name="StrengthLabel"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center">
                <TextBlock.Transitions>
                    <TransitionCollection/>
                </TextBlock.Transitions>
            </TextBlock>
            
            <!-- Length slider -->
            <Slider x:Name="LengthSlider"
                     Header="Length"
                     Minimum="8"
                     Maximum="64"
                     Value="16"
                     StepFrequency="1"
                     TickFrequency="8"
                     TickPlacement="Outside"
                     ValueChanged="LengthSlider_ValueChanged"/>
            
            <!-- Options -->
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <CheckBox x:Name="UpperCheck"
                          Grid.Row="0"
                          Grid.Column="0"
                          Content="Uppercase (A-Z)"
                          IsChecked="True"/>
                
                <CheckBox x:Name="LowerCheck"
                          Grid.Row="0"
                          Grid.Column="1"
                          Content="Lowercase (a-z)"
                          IsChecked="True"/>
                
                <CheckBox x:Name="DigitsCheck"
                          Grid.Row="1"
                          Grid.Column="0"
                          Content="Digits (0-9)"
                          IsChecked="True"/>
                
                <CheckBox x:Name="SymbolsCheck"
                          Grid.Row="1"
                          Grid.Column="1"
                          Content="Symbols (!@#...)"
                          IsChecked="True"/>
                
                <CheckBox x:Name="AmbiguousCheck"
                          Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Content="Exclude ambiguous characters (0, O, l, 1, etc.)"/>
            </Grid>
            
            <Button Content="Generate Password"
                    Click="GenerateButton_Click"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}">
                <Button.Icon>
                    <FontIcon Glyph="&#xE9A1;"/>
                </Button.Icon>
            </Button>
        </StackPanel>
    </Grid>
</Page>