<Page
    x:Class="BitNet.Desktop.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BitNet.Desktop.Views">
    
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Search & Actions toolbar -->
        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="Search entries..."
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center"/>

            <!-- Bitwarden-style type filter. Each
                 ComboBoxItem's Tag is a kind identifier
                 that the code-behind maps onto a
                 category. "all" disables the kind
                 filter; the other tags match the JSON
                 `kind` field from the Rust core. -->
            <ComboBox x:Name="TypeFilter"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="TypeFilter_SelectionChanged"
                      Margin="12,0,0,0"
                      MinWidth="140"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="All" Tag="all"/>
                <ComboBoxItem Content="Logins" Tag="login"/>
                <ComboBoxItem Content="Cards" Tag="card"/>
                <ComboBoxItem Content="Identities" Tag="identity"/>
                <ComboBoxItem Content="Notes" Tag="note"/>
                <ComboBoxItem Content="SSH keys" Tag="ssh"/>
            </ComboBox>

            <Button Grid.Column="2"
                    Content="Refresh"
                    Click="Refresh_Click"
                    Margin="12,0,0,0"></Button>

            <Button Grid.Column="3"
                    Content="Save Vault"
                    Click="SaveVault_Click"
                    Margin="12,0,0,0"></Button>

            <Button Grid.Column="4"
                    Content="Add Entry"
                    Click="AddEntry_Click"
                    Margin="12,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"></Button>
        </Grid>
        
        <!-- Entry count label -->
        <TextBlock x:Name="CountLabel"
                   Grid.Row="1"
                   Margin="12,0,12,0"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="0 entries"/>
        
        <!-- Entries list -->
        <ListView x:Name="EntriesList" 
                  Grid.Row="2"
                  Margin="12,0,12,12"
                  SelectionChanged="EntriesList_SelectionChanged"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="EntriesList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:VaultEntry">
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon -->
                        <FontIcon Grid.Column="0"
                                  Glyph="{x:Bind IconGlyph}"
                                  FontSize="24"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Margin="0,0,4,0"/>
                        
                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Username}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <TextBlock.Transitions>
                                    <TransitionCollection/>
                                </TextBlock.Transitions>
                            </TextBlock>
                            <TextBlock Text="{x:Bind Url}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <!-- TOTP indicator & Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="TOTPIcon"
                                      Glyph="&#xE9D9;"
                                      FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="{x:Bind HasTOTP}"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="TOTP enabled"/>
                            
                            <Button Content="Copy"
                                    Click="CopyPassword_Click"
                                    Tag="{x:Bind UUID}"
                                    Style="{StaticResource SubtleButtonStyle}"></Button>
                            
                            <Button Content="Delete"
                                    Click="DeleteEntry_Click"
                                    Tag="{x:Bind UUID}"
                                    Style="{StaticResource SubtleButtonStyle}"></Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
