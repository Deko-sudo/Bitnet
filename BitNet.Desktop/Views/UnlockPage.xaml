<Page
    x:Class="BitNet.Desktop.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid>
        <!-- Subtle background decoration -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource LayerFillColorDefault}" Offset="0"/>
                <GradientStop Color="{ThemeResource LayerFillColorAlt}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource LayerFillColorDefault}" Opacity="0.85"/>
            </Grid.Background>
            <Grid.Shadow>
                <ThemeShadow/>
            </Grid.Shadow>
            
            <StackPanel Padding="32,40" Spacing="16">
                <!-- Logo / Icon -->
                <FontIcon Glyph="&#xE8D7;" FontSize="64" HorizontalAlignment="Center"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                
                <TextBlock Text="BitNet" 
                          Style="{StaticResource TitleLargeTextBlockStyle}"
                          HorizontalAlignment="Center"
                          FontWeight="Bold"/>
                <TextBlock Text="Secure Password Manager"
                          Style="{StaticResource BodyTextBlockStyle}"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,-8,0,8"/>
                
                <TextBox x:Name="VaultPathBox" 
                         Header="Vault file"
                         PlaceholderText="Select your .bitnet vault file..."
                         IsReadOnly="True"
                         TextChanged="VaultPathBox_TextChanged"></TextBox>
                
                <PasswordBox x:Name="MasterPasswordBox"
                             Header="Master password"
                             PlaceholderText="Enter your master password"
                             KeyDown="MasterPasswordBox_KeyDown"
                             PasswordChanged="MasterPasswordBox_PasswordChanged"/>

                <!-- Password strength meter (Bitwarden-style) -->
                <Grid x:Name="StrengthPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="StrengthBar"
                                 Grid.Row="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="4"/>
                    <TextBlock x:Name="StrengthLabel"
                               Grid.Row="1"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Text=""/>
                </Grid>
                
                <Button x:Name="UnlockButton"
                        Content="Unlock Vault"
                        Click="UnlockButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,8,0,0"/>
                
                <Button x:Name="HelloButton"
                        Content="Windows Hello"
                        Click="HelloButton_Click"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        Margin="0,8,0,0"/>
                
                <Button Content="Create New Vault"
                        Click="CreateButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource DefaultButtonStyle}"/>
                
                <TextBlock x:Name="ErrorText"
                         Foreground="{ThemeResource SystemFillColorCautionBrush}"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>